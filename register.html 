
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#070b16">

    <title>Create Account | CYBERNEXA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="style.css">
</head>

<body class="auth-page">

    <div class="background-glow"></div>

    <header class="auth-navbar">
        <a href="index.html" class="logo">
            <span class="logo-icon">N</span>
            CYBER<span>NEXA</span>
        </a>

        <a href="index.html" class="back-home">← Back to Home</a>
    </header>

    <main class="auth-container">

        <section class="auth-card">

            <div class="auth-brand-icon">⬡</div>

            <span class="section-tag">JOIN THE SECURITY REVOLUTION</span>

            <h1>Create <span>Account.</span></h1>

            <p class="auth-description">
                Create your CYBERNEXA account and enter the next generation of cybersecurity.
            </p>

            <form id="registerForm">

                <div class="form-group">
                    <label for="fullName">Full Name</label>
                    <input
                        type="text"
                        id="fullName"
                        name="fullName"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        minlength="3"
                        maxlength="80"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="registerEmail">Email Address</label>
                    <input
                        type="email"
                        id="registerEmail"
                        name="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="registerPassword">Password</label>

                    <div class="password-wrapper">
                        <input
                            type="password"
                            id="registerPassword"
                            name="password"
                            placeholder="Create a strong password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            data-toggle="registerPassword"
                        >
                            Show
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>

                    <div class="password-wrapper">
                        <input
                            type="password"
                            id="confirmPassword"
                            name="confirmPassword"
                            placeholder="Confirm your password"
                            autocomplete="new-password"
                            minlength="8"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            data-toggle="confirmPassword"
                        >
                            Show
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="remember-option">
                        <input type="checkbox" id="terms" required>
                        <span>
                            I agree to the Terms of Service and Privacy Policy.
                        </span>
                    </label>
                </div>

                <button type="submit" class="auth-submit">
                    Create Account <span>↗</span>
                </button>

                <p id="registerMessage" class="auth-message" role="status"></p>

            </form>

            <div class="auth-divider">
                <span>ALREADY HAVE AN ACCOUNT?</span>
            </div>

            <a href="login.html" class="register-link">
                Sign In Instead
            </a>

            <p class="auth-security">
                ⬡ Your security is our priority.
            </p>

        </section>

    </main>

    <footer class="auth-footer">
        © 2026 CYBERNEXA. All Rights Reserved.
    </footer>

    <script src="register.js"></script>

</body>
</html>
